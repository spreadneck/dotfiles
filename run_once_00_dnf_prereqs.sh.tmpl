#!/usr/bin/env sh
set -euo pipefail

REQUIRED_PACKAGES="git curl zsh python3 python3-pip python3-virtualenv chezmoi"

if ! command -v dnf >/dev/null 2>&1; then
    echo "dnf not found; skipping package installation."
    exit 0
fi

DNF_CMD="dnf"
if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then
        DNF_CMD="sudo dnf"
    else
        echo "sudo is required to install packages with dnf. Install sudo or run chezmoi as root."
        exit 1
    fi
fi

set -x
$DNF_CMD install -y $REQUIRED_PACKAGES
set +x
