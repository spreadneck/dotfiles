#!/usr/bin/env sh
set -e

CHEZCTL_HOME="$HOME/.local/share/chezctl"
VENV="$CHEZCTL_HOME/venv"
PKGDIR="$HOME/.local/share/chezmoi/scripts/chezctl"

mkdir -p "$CHEZCTL_HOME"

if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 not found. Please install Python and re-run."
    exit 1
fi

if [ ! -d "$VENV" ]; then
    python3 -m venv "$VENV"
fi

. "$VENV/bin/activate"

pip install -U pip
pip install -r "$PKGDIR/requirements.txt"

