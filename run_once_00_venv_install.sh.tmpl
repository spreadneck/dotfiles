#!/usr/bin/env sh
set -e

CHEZCTL_HOME="$HOME/.local/share/chezctl"
VENV="$CHEZCTL_HOME/venv"
PKGDIR="$HOME/.local/share/chezmoi/scripts/chezctl"

mkdir -p "$CHEZCTL_HOME"

if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 not found. Please install Python and re-run."
    exit 1
fi

if [ ! -d "$VENV" ]; then
    python3 -m venv "$VENV"
fi

. "$VENV/bin/activate"

pip install -U pip
pip install -r "$PKGDIR/requirements.txt"

# Ensure the chezctl package (stored in the chezmoi scripts directory) is always
# importable from the virtual environment.
python - <<'PY'
import site
import sys
from pathlib import Path

site_packages = site.getsitepackages()[0]
pth_file = Path(site_packages) / "chezctl.pth"

scripts_path = Path.home() / ".local" / "share" / "chezmoi" / "scripts"
pth_file.write_text(str(scripts_path) + "\n")
print(f"Configured {pth_file} to add {scripts_path} to sys.path", file=sys.stderr)
PY

